DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# A définir dans RevenueCat > Project Settings > Webhooks (valeur du header
# "Authorization" que RevenueCat envoie) — vide pour l'instant, le webhook
# rejettera toutes les requêtes tant que ce n'est pas rempli des deux côtés.
REVENUECAT_WEBHOOK_SECRET=

SUPABASE_URL="https://[project-ref].supabase.co"
# A obtenir dans Supabase > Project Settings > API (clé service_role, jamais exposée au client) — utilisée par /api/coach pour vérifier le token de session envoyé par le mobile.
SUPABASE_SERVICE_ROLE_KEY="..."

# A obtenir sur openrouter.ai/keys — seule clé LLM réellement utilisée pour
# l'instant par /api/coach et /api/program-insight (passage par OpenRouter
# tant que le compte Anthropic direct n'a pas de crédit, cf. mémoire projet
# "coach-mocked"). Il n'y a pas de bascule automatique vers une clé Anthropic
# directe dans le code actuel malgré la dépendance @anthropic-ai/sdk encore
# présente dans package.json.
OPENROUTER_API_KEY="sk-or-v1-..."
