{
  "expo": {
    "name": "Cheval",
    "slug": "cheval",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cheval",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cheval.app",
      "entitlements": {
        "com.apple.developer.in-app-payments": [
          "merchant.com.cheval.app"
        ]
      }
    },
    "android": {
      "package": "com.cheval.app"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.cheval.app",
          "enableGooglePay": false
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
