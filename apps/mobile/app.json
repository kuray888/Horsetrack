{
  "expo": {
    "name": "Horsetrack",
    "slug": "horsetrack",
    "version": "1.0.3",
    "orientation": "portrait",
    "scheme": "horsetrack",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.horsetrack.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.horsetrack.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-mark.png",
        "backgroundColor": "#F6F4F0"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withSwiftVersion",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F4F0"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Horsetrack utilise Face ID pour sécuriser l'accès à ton compte."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Horsetrack a besoin d'accéder à tes photos pour ajouter une photo de cheval."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Horsetrack utilise ta position pour enregistrer la météo du jour sur ton journal de travail."
        }
      ],
      "expo-build-properties",
      "expo-status-bar",
      "@sentry/react-native",
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "21834375-e18a-4102-a029-17f34f85433d"
      }
    },
    "owner": "kuraayys-team"
  }
}
