{
  "expo": {
    "name": "Horsetrack",
    "slug": "horsetrack",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "horsetrack",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.horsetrack.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.horsetrack.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-mark.png",
        "backgroundColor": "#F6F4F0"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withSwiftVersion",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F4F0"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Horsetrack utilise Face ID pour sécuriser l'accès à ton compte."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#274c77"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Horsetrack a besoin d'accéder à tes photos pour ajouter une photo de ton cheval ou d'un document.",
          "cameraPermission": "Horsetrack utilise l'appareil photo pour photographier ton cheval, une ordonnance ou une facture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Horsetrack utilise ta position pour enregistrer la météo du jour sur ton journal de travail."
        }
      ],
      "expo-build-properties",
      "expo-status-bar",
      "@sentry/react-native",
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c10e0d8-3180-4faa-a194-97be4ca3cfbe"
      }
    },
    "owner": "batyeooo"
  }
}
