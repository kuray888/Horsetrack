{
  "expo": {
    "name": "Horsetrack",
    "slug": "horsetrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "horsetrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cheval.app"
    },
    "android": {
      "package": "com.cheval.app"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Horsetrack a besoin d'accéder à tes photos pour ajouter une photo de cheval."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
