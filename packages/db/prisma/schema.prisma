/// Journal des appels au coach IA (cf. apps/api/src/lib/coach) : tokens,
/// coût estimé, issue — jamais le contenu. Sert aussi aux quotas et au
/// plafond de dépense mensuel. Réservé à l'API (RLS sans policy).
model CoachCall {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// suggestion, question, summary.
  kind   String
  model  String
  /// ok, fallback, medical, refusal, error, cached.
  status String

  inputTokens      Int     @default(0)
  outputTokens     Int     @default(0)
  cacheReadTokens  Int     @default(0)
  cacheWriteTokens Int     @default(0)
  /// Coût estimé en millionièmes de dollar.
  costMicros       Int     @default(0)
  errorCode        String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("coach_calls")
}

/// « Ta prochaine séance » du jour, une par cheval et par jour : relue au
/// lieu de rappeler le coach (quota, coût). Réservé à l'API.
model CoachSuggestion {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  horseId String
  horse   Horse  @relation(fields: [horseId], references: [id], onDelete: Cascade)
  /// AAAA-MM-JJ (jour du téléphone).
  day     String
  result  Json

  createdAt DateTime @default(now())

  @@unique([userId, horseId, day])
  @@map("coach_suggestions")
}

/// Résumé du mois, calculé en lot (Batch API). Les faits envoyés sont
/// effacés dès le résumé obtenu. Réservé à l'API.
model CoachSummary {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  horseId String
  horse   Horse   @relation(fields: [horseId], references: [id], onDelete: Cascade)
  /// AAAA-MM.
  month   String
  lang    String  @default("fr")
  /// PENDING, SUBMITTED, DONE, FAILED.
  status  String  @default("PENDING")
  facts   Json?
  batchId String?
  summary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, horseId, month])
  @@index([status])
  @@map("coach_summaries")
}

/// Fil privé d'un cheval : commentaire sur une séance ou un souvenir, entre
/// le propriétaire et les personnes avec qui il est partagé (RLS
/// can_access_horse). `authorRole` est posé par la base (trigger), jamais
/// par l'app.
model HorseComment {
  id           String @id
  horseId      String
  horse        Horse  @relation(fields: [horseId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  /// OWNER, DEMI_PENSION, COACH, RIDER, GROOM.
  authorRole   String @default("OWNER")
  /// session, journal.
  targetType   String
  targetId     String
  body         String

  createdAt DateTime @default(now())

  reports CommentReport[]

  @@index([horseId, targetType, targetId])
  @@map("horse_comments")
}

/// Réaction (emoji d'une liste fermée) sur une séance ou un souvenir.
model HorseReaction {
  id         String @id
  horseId    String
  horse      Horse  @relation(fields: [horseId], references: [id], onDelete: Cascade)
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  emoji      String

  createdAt DateTime @default(now())

  @@unique([targetType, targetId, userId, emoji])
  @@index([horseId])
  @@map("horse_reactions")
}

/// Signalement d'un commentaire, traité depuis la console /admin.
model CommentReport {
  id             String       @id @default(cuid())
  commentId      String
  comment        HorseComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterUserId String
  reason         String       @default("")
  resolvedAt     DateTime?

  createdAt DateTime @default(now())

  @@unique([commentId, reporterUserId])
  @@map("comment_reports")
}

/// Jeton de notification push (Expo) d'un appareil.
model PushToken {
  token    String @id
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform String
  /// Langue de l'app sur cet appareil : celle de la notification.
  lang     String @default("fr")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}
