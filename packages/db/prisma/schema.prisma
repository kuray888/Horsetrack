/// Palier d'abonnement — un seul palier payant dans le produit réellement
/// exécuté (pivot du 2026-06-19, cf. git log), pas de gestion d'écurie/
/// multi-utilisateurs avancée (hors scope HorseTrack, cf. HorsePlanning).
/// Grille tarifaire réelle affichée par PaywallView.tsx/paywall.tsx : FREE 0€
/// (1 cheval) → GRAND_PRIX 3,99€/mois ou 39,99€/an (chevaux illimités,
/// coffre-fort, partage, stats, rappels auto). Pivot chevaux illimités du
/// 2026-09-05 (v3) : l'ancien add-on "cheval supplémentaire" (entitlement
/// RevenueCat `extra_horse`, colonne `Horse.extraHorseSlots` ci-dessus) n'est
/// plus vendu ni lu par aucune logique métier (cf. effective_horse_limit()
/// dans rls.sql) — la colonne reste en base (verrouillée côté client par
/// protect_rider_profile_entitlements) sans qu'aucune migration ne soit
/// nécessaire pour ce pivot. L'identifiant `GRAND_PRIX` (et l'entitlement
/// RevenueCat `grand_prix`, cf. lib/revenuecat.ts) est un nom interne hérité
/// d'un ancien modèle à 3 paliers, conservé tel quel pour éviter une
/// reconfiguration du dashboard RevenueCat/App Store — il ne reflète plus un
/// positionnement "haut de gamme", juste LE palier payant unique. Pas de
/// génération de contenu par IA dans ce palier (retirée du produit, cf.
/// TrainingSession/ActivityType plus haut) : le "Coach IA" évoqué par un
/// ancien document produit n'existe plus dans le code exécuté.
enum SubscriptionTier {
  FREE
  /// Valeur legacy de l'ancien modèle à 3 paliers — plus jamais attribuée par
  /// le webhook RevenueCat (cf. apps/api/.../revenuecat/webhook/route.ts) ni
  /// choisissable dans l'app (un seul palier payant, GRAND_PRIX). Conservée
  /// dans l'enum uniquement pour ne pas risquer une migration de colonne enum
  /// Postgres sans nécessité — à supprimer si un jour aucune ligne ne la
  /// référence plus.
  PADDOCK
  GRAND_PRIX

  @@map("subscription_tier")
}

/// Fréquence de facturation — indépendante du palier (Free n'en a pas).
enum BillingPeriod {
  MONTHLY
  ANNUAL

  @@map("billing_period")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

/// Trace les events RevenueCat déjà traités (clé = `event.id` du payload
/// webhook) — évite qu'un retry du même event (RevenueCat redélivre si on ne
/// répond pas 200, ex: timeout réseau côté nous) ne re-déclenche le switch de
/// /api/revenuecat/webhook. Juste l'id : aucun autre champ n'a besoin d'être
/// gardé, on ne fait que vérifier "déjà vu ou pas".
model RevenueCatWebhookEvent {
  id          String   @id
  processedAt DateTime @default(now())

  @@map("revenuecat_webhook_events")
}

/// Rappel email programmé pour un rendez-vous d'agenda — pas un miroir complet
/// de l'agenda (qui reste local-first sur mobile), juste assez d'info pour
/// pouvoir envoyer un email au bon moment (cf. apps/api/.../cron/email-reminders).
/// Écrit uniquement par le backend (connexion DATABASE_URL qui bypass RLS),
/// jamais directement par le client.
model EmailReminder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sendAt  DateTime
  subject String
  body    String
  sentAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sendAt, sentAt])
  @@map("email_reminders")
}

/// Sécurité en balade (Premium) : position partagée avec des proches pendant
/// une séance en direct, et alerte quand le cavalier ne bouge plus. Réservée à
/// l'API (RLS sans policy). L'id est le jeton du lien de suivi /suivi/<id>.
/// Seule la dernière position est gardée.
model RideShare {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  riderName String
  horseName String
  /// [{ name, email }] — 1 à 3 proches.
  contacts  Json
  /// ACTIVE, ALERT (alerte envoyée), ENDED.
  status    String @default("ACTIVE")

  startedAt        DateTime  @default(now())
  lastLat          Float?
  lastLng          Float?
  lastAccuracy     Float?
  lastPointAt      DateTime?
  alertSentAt      DateTime?
  staleAlertSentAt DateTime?
  endedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("ride_shares")
}

/// Parrainage : un code par cavalier (cf. apps/api/src/lib/referrals.ts).
/// Réservé à l'API (RLS sans policy).
model ReferralCode {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  code   String @unique

  createdAt DateTime @default(now())

  @@map("referral_codes")
}

/// Un filleul (une ligne par compte parrainé). `rewardedAt` : mois offert au
/// parrain au premier paiement du filleul (webhook RevenueCat).
model ReferralUse {
  refereeUserId  String    @id
  referrerUserId String
  code           String
  rewardedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([referrerUserId])
  @@map("referral_uses")
}

/// Identité, alimentation et demi-pension d'un cheval (cf.
/// apps/mobile/src/extras/model.ts) — une ligne par cheval.
model HorseDetails {
  horseId     String @id
  horse       Horse  @relation(fields: [horseId], references: [id], onDelete: Cascade)
  identity    Json   @default("{}")
  feeding     Json   @default("{}")
  partnership Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("horse_details")
